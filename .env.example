# Where your nodes reach the dashboard. Goes into every install command, so use an
# address the machines can resolve (a domain behind your reverse proxy, a Tailscale name, ...).
PUBLIC_URL=https://fleet.example.com

ADMIN_USER=admin
# Plain password (hashed at startup) ...
ADMIN_PASSWORD=change-me
# ... or a hash instead: docker compose run --rm dashboard bun -e 'console.log(await Bun.password.hash("..."))'
# ADMIN_PASSWORD_HASH=

# Encrypts Pirate Face keys at rest. Generate once with: openssl rand -hex 32
# Changing it later makes the stored keys unreadable (set them again in Accounts).
APP_SECRET=

# Set to 1 when a reverse proxy sits in front, so login rate limits see real client IPs.
TRUST_PROXY=0

# Host port for docker compose.
PF_FLEET_PORT=1337

# Image tag for docker compose: latest (newest release), 0.2 (follow a minor line), edge (every push to main).
PF_FLEET_TAG=latest
